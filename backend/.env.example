# Mercado Pago Configuration
# Get your Access Token from: https://www.mercadopago.com.br/developers/pt/docs/checkout-pro/create-application
# Steps:
# 1. Log in to Mercado Pago Developer Dashboard
# 2. Navigate to "Suas integrações" → "Credenciais"
# 3. Copy your PRODUCTION Access Token (starts with APP_USR_)
# 4. Replace the placeholder below
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_REPLACE_WITH_YOUR_TOKEN

# URLs Configuration
# FRONTEND_URL: Where your React app is deployed
# BACKEND_URL: Where this Express server is deployed
# ⚠️ IMPORTANT: Both must be HTTPS in production (required by Mercado Pago for webhooks)
FRONTEND_URL=https://alanamatheus.shop
BACKEND_URL=https://your-railway-backend.railway.app

# Supabase Configuration
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://jmwbzgpsbhmzlcrfeufg.supabase.co
SUPABASE_KEY=sb_secret_YOUR_KEY_HERE

# Node Environment
# Use 'development' for local testing, 'production' for Railway
NODE_ENV=production
PORT=3000

# Optional: Enable all CORS origins (debug only, disable in production)
# ALLOW_ALL_ORIGINS=false

# Optional: Additional allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://example.com,https://another.com
